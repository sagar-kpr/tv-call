{
  "name": "@homeping/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p .",
    "start": "node --env-file=../../.env dist/apps/server/src/index.js",
    "start:hosted": "node dist/apps/server/src/index.js",
