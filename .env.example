PORT=3000
# Built into the single APK for phone and TV. Users never type this address.
HOMEPING_BACKEND_URL=https://your-deployed-homeping-server.example
WEB_URL=https://your-project-id.web.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-public-firebase-api-key
# Firebase application ID for the unified Android package dev.tvcall.caller.
FIREBASE_ANDROID_APP_ID=1:123456789:android:abcdef
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# OAuth client IDs used by Google sign-in. Email/password works without these.
GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=123456789-example.apps.googleusercontent.com
# Absolute path to a service account JSON kept OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Allowed web origins, comma separated. Include your Firebase Hosting address.
WEB_ORIGIN=http://localhost:5173
